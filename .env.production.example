# PRODUCTION template for the Docker Compose deployment (EC2).
#   cp .env.production.example .env    # then edit, and `docker compose up -d --build`
# Compose reads this file both for ${...} interpolation and as the backend's
# env_file. NEVER commit the filled-in .env.
#
# NOTE: NODE_ENV, PORT and UPLOAD_DIR are set by docker-compose.yml
# and intentionally override anything here — they describe the container's own
# wiring, not a choice you make per environment.

# ---- Public URLs ------------------------------------------------------------
# These are the FRONTEND's origin, not this machine's. The API is reached only
# through the frontend's /api/v1 proxy, so that is the URL users actually see.
# APP_URL also decides cookie security: an https:// value switches the refresh
# cookie to Secure+SameSite=None, http:// leaves it Lax.
APP_URL=http://<frontend-public-ip>:3000
API_URL=http://<frontend-public-ip>:3000

# Comma-separated allowlist. Proxied calls arrive with no Origin header and are
# always permitted; this only matters if a browser calls the API directly.
CORS_ORIGINS=http://<frontend-public-ip>:3000

# Refresh-cookie security. Left unset it follows the APP_URL scheme, which is
# what you want: over plain http browsers silently DROP a Secure cookie, so
# forcing true here would break login. Set true once the frontend has TLS.
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.ghanipur.pk

# ---- Auth secrets -----------------------------------------------------------
# Generate each with:  openssl rand -hex 32     (min 16 chars, boot fails below that)
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- Provisioning keys (x-setup-key header) ---------------------------------
# Generate with:  openssl rand -hex 20
SUPER_ADMIN_SETUP_KEY=replace-with-unique-random
ADMIN_SETUP_KEY=replace-with-unique-random

# ---- Password-reset OTP -----------------------------------------------------
OTP_TTL_MIN=2
OTP_LENGTH=4
OTP_RESEND_COOLDOWN_SEC=120
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_MIN=15
# MUST stay false in production — true echoes the OTP in the API response.
EXPOSE_OTP=false

# ---- SMTP -------------------------------------------------------------------
# Leave unset to log the OTP to the container instead of emailing it. Password
# reset then only works via `docker compose logs backend`.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=Ghanipur <no-reply@ghanipur.pk>

# ---- DynamoDB (not yet in use) ----------------------------------------------
# Every module still reads Mongo; these tables are scaffolding for the migration.
# DYNAMO_REQUIRED=false means an unreachable table logs a warning instead of
# killing the process at boot. Flip to true once the port is complete.
AWS_REGION=ap-south-1
DYNAMO_REQUIRED=false
# On EC2 prefer an IAM instance role over static keys — the SDK picks it up
# automatically. Set these only if you have no instance role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DYNAMO_TABLE_PREFIX=

# ---- Image storage (S3) -----------------------------------------------------
# Private bucket; the API streams objects back on /uploads/<key>, so images stay
# same-origin and the bucket never needs to be public. Access comes from the EC2
# instance role — do NOT put AWS keys here.
S3_BUCKET=ghanipur-uploads-983902695520
# S3_PREFIX=          # optional namespace within the bucket, e.g. "products/"

# ---- Misc -------------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
MAX_UPLOAD_BYTES=5242880

# Host port for the API. Published on all interfaces so the frontend machine can
# reach it — the SECURITY GROUP is what restricts access. Allow inbound 5000
# from the frontend instance only, never 0.0.0.0/0.
BACKEND_PORT=5000
