# PRODUCTION template for ghanipur.pk. Copy to .env.production (or .env) on the
# server and fill in the real secrets. NEVER commit the filled-in file.
# In the Docker combined stack this one file drives BOTH backend and frontend.

NODE_ENV=production
PORT=5000

# MongoDB — service name inside the compose network; replica set required for transactions.
MONGO_URI=mongodb://mongo:27017/ghanipur?replicaSet=rs0

# Auth secrets — generate each with:  openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Domain / URLs
CORS_ORIGINS=https://ghanipur.pk,https://www.ghanipur.pk
APP_URL=https://ghanipur.pk
API_URL=https://ghanipur.pk
COOKIE_SECURE=true

# Provisioning keys (x-setup-key header) — use unique random values: openssl rand -hex 20
SUPER_ADMIN_SETUP_KEY=replace-with-unique-random
ADMIN_SETUP_KEY=replace-with-unique-random

# Password-reset OTP
OTP_TTL_MIN=2
OTP_LENGTH=4
OTP_RESEND_COOLDOWN_SEC=120
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_MIN=15
EXPOSE_OTP=false

# SMTP — required in production so OTP emails actually send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Ghanipur <no-reply@ghanipur.pk>

# Uploads
UPLOAD_DIR=uploads

# Frontend build args (the combined compose builds the frontend from ../frontend)
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://backend:5000
FRONTEND_CONTEXT=../frontend
