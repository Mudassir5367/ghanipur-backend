# Copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=development
PORT=5000

# MongoDB (needs a replica set for transactions)
MONGO_URI=mongodb://localhost:27017/ghanipur?replicaSet=rs0

# DynamoDB (transitional, alongside Mongo until the port is complete).
# On EC2, leave AWS_ACCESS_KEY_ID/SECRET unset — the instance role is used
# instead via the SDK's default credential chain. Set them here only for
# local Docker testing without an instance role.
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DYNAMO_ENDPOINT=http://localhost:8000   # dynamodb-local override
# DYNAMO_TABLE_PREFIX=                    # e.g. "ghanipur_" for env isolation

# Auth secrets (use long random strings, min 16 chars)
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS + URLs
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:5000
# COOKIE_SECURE=false   # follows APP_URL scheme unless set

# Provisioning keys (x-setup-key header)
SUPER_ADMIN_SETUP_KEY=super-admin-ghanipur
ADMIN_SETUP_KEY=admin-ghanipur

# Password-reset OTP
OTP_TTL_MIN=2
OTP_LENGTH=4
OTP_RESEND_COOLDOWN_SEC=120
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_MIN=15
EXPOSE_OTP=true   # local only — echoes OTP in the API response; set false once SMTP works

# SMTP for real OTP emails. Leave unset to just log the code. Example (Gmail app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=Ghanipur <you@gmail.com>

# Uploads
UPLOAD_DIR=uploads

# --- Only needed for the combined docker-compose.yml (runs mongo + backend + frontend) ---
# The compose builds the frontend from a sibling clone of the frontend repo.
# NEXT_PUBLIC_API_URL=/api/v1
# API_PROXY_TARGET=http://backend:5000
# FRONTEND_CONTEXT=../frontend   # change if the frontend repo folder has another name
